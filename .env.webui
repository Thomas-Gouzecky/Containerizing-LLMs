# /v1 - OpenAI API base URL, /v1 is required for OpenAI API compatibility for llmman

# Running llmman in a separate container
OPENAI_API_BASE_URL=http://llmman:17434/v1

# Running llmman on your machine
# OPENAI_API_BASE_URL=http://host.docker.internal:17434/v1
OPENAI_API_KEY=not-needed
WEBUI_AUTH=false
WEBUI_NAME=WebUI with llmman